from decimal import Decimal
from time import perf_counter
for count in (300, 6000, 150000):
values = ["33.40"] * count
start = perf_counter()
float_total = sum(float(x) for x in values)
float_time = perf_counter() - start
start = perf_counter()
decimal_total = sum((Decimal(x) for x in values), Decimal("0"))
decimal_time = perf_counter() - start
print("Entries:", count)
print("Float total:", f"{float_total:.2f}", "time:", f"{float_time:.6f}", "s")
print("Decimal total:", decimal_total, "time:", f"{decimal_time:.6f}", "s")
