# Benchmark dictionary merge with 1,000 and 100,000 generated contacts
for n in (1000, 100000):
    sample = [{"name":"Person"+str(i), "phones":["90000"+str(i).zfill(5)],
               "emails":[]} for i in range(n)]
    start=time.perf_counter()
    merged_result=merge_contacts(sample)
    print(n, "contacts:", time.perf_counter()-start, "seconds",
          "merged:", len(merged_result))
